<Window x:Class="TKVoice.App.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TK Voice – OpenAI API Key"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
            Der Key wird im Windows Credential Manager gespeichert, nicht in einer Konfigurationsdatei.
        </TextBlock>
        <PasswordBox x:Name="KeyBox" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Speichern" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
